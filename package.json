{
  "name": "idle-break",
  "productName": "Idle Break",
  "version": "1.22.1",
  "description": "The break time reminder app",
  "main": "app/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron . --trace-warnings --trace-deprecation --enable-logging --remote-debugging-port=9222",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder build --dir",
    "dist": "electron-builder build",
    "test": "vitest run",
    "test-single": "vitest run $1",
    "coverage": "vitest run --coverage",
    "tdd": "vitest --watch test",
    "lint": "cross-env ./node_modules/.bin/standard",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisishappenin/idle-break.git"
  },
  "keywords": [
    "Idle Break",
    "break",
    "time",
    "reminder"
  ],
  "author": "Jan Hovancik <jan@hovancik.net>",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/thisishappenin/idle-break/issues"
  },
  "homepage": "https://github.com/thisishappenin/idle-break",
  "build": {
    "appId": "io.github.thisishappenin.idlebreak",
    "productName": "Idle Break",
    "win": {
      "target": [
        "nsis",
        "7z",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "standard": {
    "globals": [
      "it",
      "describe",
      "before",
      "after",
      "beforeEach",
      "afterEach",
      "Audio",
      "fetch",
      "Notification",
      "alert",
      "__electronLog"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "rimraf": "^6.1.3",
    "standard": "^17.1.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "humanize-duration": "^3.35.0",
    "i18next": "^26.5.6",
    "i18next-fs-backend": "^2.6.9",
    "luxon": "^3.7.2",
    "meeussunmoon": "^3.1.0",
    "node-desktop-idle-v2": "^1.1.26",
    "ps-list": "^9.0.0",
    "semver": "^7.8.5",
    "windows-focus-assist": "^1.4.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "node-desktop-idle-v2@1.1.26": true,
    "windows-focus-assist@1.4.0": true
  }
}
